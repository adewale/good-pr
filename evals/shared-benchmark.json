    {
      "id": "pos-renderer-evidence-provenance",
      "split": "tune",
      "kind": "pr-review",
      "prompt": "My PR fixes a label-overlap bug in our open-source SVG chart renderer. For visual evidence I attached two screenshots I took of the demo page on my laptop — one from before my change and one from after. Is that good enough, or should I do anything else with the visual evidence before submitting?",
      "expected_behavior": [
        "Recommend generating the before/after images from the renderer itself (base commit vs. branch) rather than hand-captured demo-page screenshots.",
        "Recommend captioning each pair with the specific defect it demonstrates.",
        "Recommend including the command to regenerate the artifacts so reviewers can reproduce the evidence."
      ],
