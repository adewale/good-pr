    {
      "id": "pos-security-meaningless-test",
      "split": "tune",
      "kind": "pr-review",
      "prompt": "Security fix PR includes `expect(result).toBeDefined()` as the only auth-bypass test, and the draft title is `[URGENT] Fix auth bypass`. Review it before I submit.",
      "expected_behavior": [
        "Flag the test as non-evidence, ask for targeted regression proof that fails on the vulnerable or reverted code, and handle urgency in a maintainer-friendly way without cargo-cult demands."
      ],
      "assertions": [
        {
          "name": "detect-security-meaningless-test",
          "type": "contains_any",
          "values": [
            "meaningless",
            "not meaningful",
            "not a meaningful",
            "not valid",
            "not a valid",
            "doesn't prove",
            "does not prove",
            "doesn't verify",
            "only proves",
            "false confidence",
            "proves almost nothing",
            "almost nothing",
            "proves nothing",
            "weak"
          ]
        },
        {
          "name": "requires-reverted-fix-proof",
          "type": "contains_any",
          "values": [
            "fails when the fix is reverted",
            "fail when the fix is reverted",
            "fails without the fix",
            "fail if the bug is reintroduced",
            "fail when the bug is reintroduced",
            "fail if the vulnerability is reintroduced",
            "fail when the vulnerability is reintroduced",
            "fail on the vulnerable",
            "fail on the original bypass",
            "would fail on the original bypass",
            "revert/remove your auth fix",
            "revert your auth fix",
            "remove your auth fix",
            "confirm the unauthorized test fails",
            "confirm it fails",
            "fails when the auth guard is reverted",
            "auth guard is reverted",
            "verified the regression test fails when the auth guard is reverted"
          ]
        },
        {
          "name": "asks-security-invariant",
          "type": "contains_any",
          "values": [
            "401",
            "403",
            "unauthorized",
            "forbidden",
            "protected data",
            "blocked side effect"
          ]
        },
        {
          "name": "maintainer-urgency-triage",
          "type": "contains_any",
          "values": [
            "let maintainers triage",
            "let the maintainers triage",
            "maintainer triage",
            "maintainers set urgency",
            "avoid urgent",
            "don't mark urgent",
            "do not mark urgent",
            "not label it urgent",
            "do not self-label"
          ]
        },
        {
          "name": "qualitative-review",
          "type": "judge",
          "rubric": [
            "Diagnoses why the test is non-evidence",
            "Asks for targeted regression proof, not broad test theater",
            "Handles urgency and triage with maintainer empathy"
          ]
        },
        {
          "name": "with-skill-trace-loads-skill",
          "type": "skill_invoked",
          "expected": true,
          "variants": [
            "with_skill"
          ]
        },
        {
          "name": "without-skill-trace-omits-skill",
          "type": "skill_invoked",
          "expected": false,
          "variants": [
            "without_skill"
          ]
        },
        {
          "name": "trace-command-budget",
          "type": "command_count_le",
          "max": 12,
          "variants": [
            "with_skill",
            "without_skill"
          ]
        },
        {
          "name": "trace-time-budget",
          "type": "elapsed_seconds_le",
          "max": 90,
          "variants": [
            "with_skill",
            "without_skill"
          ]
        },
        {
          "name": "trace-token-budget",
          "type": "total_tokens_le",
          "max": 100000,
          "variants": [
            "with_skill",
            "without_skill"
          ]
        }
      ],
      "tags": [],
      "domain": "pull-request-quality",
      "difficulty": "extended",
      "success_goals": [
        "outcome",
